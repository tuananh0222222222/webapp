<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My E-commerce Website</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">My Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="#">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Contact</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero bg-light text-center py-5">
        <div class="container">
            <h1 class="display-4">Welcome to My Store</h1>
            <p class="lead">Explore the best products in the market</p>
            <img src="https://source.unsplash.com/1200x400/?fashion" alt="Hero Banner" class="img-fluid">
        </div>
    </section>

    <!-- Product Categories Section -->
    <section class="container py-5">
        <h2 class="text-center mb-4">Our Products</h2>
        <div class="row">
            <!-- Watch -->
            <div class="col-md-4">
                <div class="card">
                    <img src="https://source.unsplash.com/300x300/?watch" alt="Product 1" class="card-img-top">
                    <div class="card-body">
                        <h5 class="card-title">Stylish Watch</h5>
                        <p class="card-text">$199.99</p>
                        <a href="#" class="btn btn-primary">View Product</a>
                    </div>
                </div>
            </div>

            <!-- Shoes -->
            <div class="col-md-4">
                <div class="card">
                    <img src="https://source.unsplash.com/300x300/?shoes" alt="Product 2" class="card-img-top">
                    <div class="card-body">
                        <h5 class="card-title">Comfortable Shoes</h5>
                        <p class="card-text">$129.99</p>
                        <a href="#" class="btn btn-primary">View Product</a>
                    </div>
                </div>
            </div>

            <!-- Headphones -->
            <div class="col-md-4">
                <div class="card">
                    <img src="https://source.unsplash.com/300x300/?headphones" alt="Product 3" class="card-img-top">
                    <div class="card-body">
                        <h5 class="card-title">Wireless Headphones</h5>
                        <p class="card-text">$89.99</p>
                        <a href="#" class="btn btn-primary">View Product</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer Section -->
    <footer class="bg-dark text-white text-center py-4">
        <p>&copy; 2025 My Store. All Rights Reserved.</p>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
